---
import '../../styles/global.css';
const { hideHeader } = Astro.props;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="QR Menu" />
    <title>QR Menu</title>
    <script>
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      }
    </script>
  </head>
  <body class="font-sans min-h-screen">
    {!hideHeader && (
      <header class="sticky top-0 z-50 bg-white/90 backdrop-blur border-b border-gray-100">
        <div class="max-w-4xl mx-auto px-4 h-14 flex items-center gap-3">
          <img src="/favicon/favicon-96x96.png" alt="QR" class="w-8 h-8" />
          <span class="font-bold text-gray-800">QR Menu</span>
        </div>
      </header>
    )}
    <slot />
  </body>
</html>
