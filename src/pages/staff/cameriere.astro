---
import Layout from '../../components/astro/Layout.astro';
import WaiterDashboard from '../../components/svelte/WaiterDashboard.svelte';
import LogoutButton from '../../components/svelte/LogoutButton.svelte';
import LangToggle from '../../components/svelte/LangToggle.svelte';
import StatsBar from '../../components/svelte/StatsBar.svelte';
import Clock from '../../components/svelte/Clock.svelte';
---

<Layout>
  <main class="max-w-4xl mx-auto p-4">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-2xl font-bold">Dashboard Cameriere</h1>
      <div class="flex items-center gap-2">
        <a href="/staff/prenotazioni" class="text-sm font-bold bg-emerald-600 text-white rounded-xl px-4 py-2 hover:bg-emerald-700 active:scale-[0.97] transition-all shadow-lg shadow-emerald-600/20">
          Prenotazioni
        </a>
        <a href="/staff/ordina" class="text-sm font-bold bg-emerald-600 text-white rounded-xl px-4 py-2 hover:bg-emerald-700 active:scale-[0.97] transition-all shadow-lg shadow-emerald-600/20 flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v14m-7-7h14"/></svg>
          Ordina
        </a>
        <LangToggle client:load />
        <Clock client:load />
        <LogoutButton client:load />
      </div>
    </div>
    <div class="mb-6">
      <StatsBar client:load />
    </div>
    <WaiterDashboard client:load />
  </main>
</Layout>
