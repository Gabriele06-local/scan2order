---
import Layout from '../../components/astro/Layout.astro';
import RegisterWizard from '../../components/svelte/RegisterWizard.svelte';
import LangToggle from '../../components/svelte/LangToggle.svelte';
---

<Layout hideHeader={true}>
  <main class="flex flex-col items-center justify-center min-h-screen p-4 bg-gradient-to-br from-gray-50 to-blue-50">
    <div class="absolute top-4 right-4">
      <LangToggle client:load />
    </div>
    <RegisterWizard client:load />
  </main>
</Layout>
