---
import Layout from '../../components/astro/Layout.astro';
import LogoutButton from '../../components/svelte/LogoutButton.svelte';
import LangToggle from '../../components/svelte/LangToggle.svelte';
import StaffPrenotazioni from '../../components/svelte/StaffPrenotazioni.svelte';
import Clock from '../../components/svelte/Clock.svelte';
---

<Layout>
  <main class="max-w-4xl mx-auto p-4">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-2xl font-bold">Prenotazioni</h1>
      <div class="flex items-center gap-4">
        <a href="/staff/admin" class="text-sm font-bold bg-emerald-600 text-white rounded-xl px-4 py-2 hover:bg-emerald-700 active:scale-[0.97] transition-all shadow-lg shadow-emerald-600/20">
          Amministrazione
        </a>
        <LangToggle client:load />
        <Clock client:load />
        <LogoutButton client:load />
      </div>
    </div>
    <StaffPrenotazioni client:load />
  </main>
</Layout>
