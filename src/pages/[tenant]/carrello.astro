---
import Layout from '../../components/astro/Layout.astro';
---

<Layout>
  <main class="max-w-lg mx-auto p-4">
    <h1 class="text-2xl font-bold mb-4">Il tuo ordine</h1>
    <p class="text-gray-500">Il carrello è gestito dall'isola interattiva nella pagina menu.</p>
    <a href={`/${Astro.params.tenant}?table=${Astro.url.searchParams.get('table')}`} class="text-blue-600 underline mt-4 block">
      Torna al menu
    </a>
  </main>
</Layout>
